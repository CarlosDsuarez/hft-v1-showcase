# Copiar a .env (en la RAIZ del repo) y completar. Nunca commitear el .env real.
# Solo se usan en modo live (yfinance/Alpaca); tests y demos son offline.
# El .env se lee solo desde la raiz del repo (no desde el cwd) y NO se
# inyecta en os.environ; el entorno real del proceso tiene prioridad.
# Cada clave aqui la lee el codigo (tests/test_settings.py lo verifica).

# --- Broker (Alpaca paper para pruebas; paso futuro) ---
BROKER_API_KEY=
BROKER_SECRET_KEY=
BROKER_BASE_URL=https://paper-api.alpaca.markets
# Cuenta paper esperada (ej. PA0000000001). Si se fija, el adaptador ABORTA
# antes de enviar nada cuando la API responda con otra cuenta.
BROKER_ACCOUNT_ID=

# --- Rutas de runtime (opcional; exportar en el entorno del proceso) ---
# Ruta ABSOLUTA donde viven data/, data/live_state/ y results/.
# Sin definir -> raiz del repo. Se lee de os.environ, no de este archivo.
# HFT_HOME=/srv/hft-v1
# Kill-switch: con HFT_KILL=1 (o un archivo data/live_state/KILL) el broker
# bloquea CUALQUIER envio de ordenes, incluso a mitad de lote.
# HFT_KILL=1
# Version de codigo para rebalance_history.csv (git_sha) cuando no hay git
# (imagen Docker: docker build --build-arg GIT_SHA=$(git rev-parse HEAD)).
# HFT_GIT_SHA=

# --- Alertas por email (opcional; src/notifier.py) ---
# Sin ALERT_EMAIL o sin ALERT_SMTP_HOST el email queda apagado: las alertas
# van solo a consola y a data/live_state/logs/alerts.jsonl.
# ALERT_EMAIL acepta varios destinatarios separados por coma.
ALERT_EMAIL=
ALERT_SMTP_HOST=
# 587 = STARTTLS (default); 465 = SSL
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
# Remitente (default: ALERT_SMTP_USER)
ALERT_EMAIL_FROM=
# info | warning | error (default) | critical
ALERT_EMAIL_MIN_LEVEL=error
